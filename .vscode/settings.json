{
  "files.associations": {
    ".zed/*.json": "jsonc",
  },
  "search.exclude": {
    "**/*.lock": true,
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
  },
  "[toml]": {
    "editor.defaultFormatter": "tombi-toml.tombi",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
  },
}
